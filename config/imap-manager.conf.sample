#########################
#        DEFAULT        #
#########################
[default]
imap_hostname = imap.domain.com
imap_username = example@domain.fr
imap_password = azerty
# The IMAP folder where imap-manager will process unread mails.
imap_mailbox = INBOX
# Polling interval in seconds (aka the time between each processing)
# For example if the process takes 3 seconds, the next one will be
# 8 seconds after the start of it.
polling_interval = 5
# If a mail has no rule (no subject nor from nor to rules),
# it will be moved in this one.
default_folder = others

#########################
#        FILTERS        #
#########################

[subject]
"[SPAM]" = spamFolder
"*** SPAM ***" = spamFolder

[from]
"mail1@domain.com" = folder1

[to]
"mail1@domain1.com" = folder1
"mail2@domain1.com" = folder2

